5. Write a program to make the main process to wait for the child process to complete
#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>
int main() {
pid_t pid = fork();
if (pid == 0) {
printf("Child working...\n");
sleep(1);
printf("Child done.\n");
exit(0);
} else {
int status;
waitpid(pid, &status, 0); 
printf("Main (parent) process: Child completed.\n");
}
return 0;
}






