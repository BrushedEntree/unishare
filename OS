7 Single function handling multiple threads using many to one thread model.
AIM: To illustrate how a single function can handle more than one thread.
PROGRAM:
#include<stdio.h>
#include<pthread.h>
int a,b;
pthread_t tid[3];
void* demo(void* args)
{
pthread_t temp;
temp=pthread_self();
if(pthread_equal(tid[0],temp))
{
printf("Thread-0 matched..sum=%d\n",a+b);
}
else if(pthread_equal(tid[1],temp))
{
printf("Thread-1 matched..subtract=%d\n",a-b);
}
else
{
printf("Thread-2 matched..product=%d\n",a*b);
}
}
int main()
{
int i;
printf("Enter the values of a,b:");
scanf("%d%d",&a,&b);
for(i=0;i<3;i++)
pthread_create(&tid[i],NULL,demo,NULL);
for(i=0;i<3;i++)
pthread_join(tid[i],NULL);
return 0;
}






8. FCFS Scheduling
#include <stdio.h>
int main() {
    int n;
    int at[10], bt[10], ct[10], wt[10], tat[10];
    float avg_wt = 0, avg_tat = 0;
    printf("Enter number of processes: ");
    scanf("%d", &n);
    for (int i = 0; i < n; i++) {
        printf("Enter Arrival Time and Burst Time for P%d: ", i + 1);
        scanf("%d %d", &at[i], &bt[i]);
    }
    int current_time = 0;
    for (int i = 0; i < n; i++) {
        if (current_time < at[i])
            current_time = at[i];
        ct[i] = current_time + bt[i];
        current_time = ct[i];
        tat[i] = ct[i] - at[i];
        wt[i] = tat[i] - bt[i];
        avg_wt += wt[i];
        avg_tat += tat[i];
    }
    printf("\nProcess\tAT\tBT\tWT\tTAT\n");
    for (int i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t%d\n",
               i + 1, at[i], bt[i], wt[i], tat[i]);
    }
    printf("\nAverage Waiting Time = %.2f", avg_wt / n);
    printf("\nAverage Turnaround Time = %.2f\n", avg_tat / n);

    return 0;
}






9. SJF (Non-preemptive)
#include <stdio.h>
struct Process {
int id, bt, wt, tat;
};
int main() {
struct Process p[4] = {{1,5}, {2,8}, {3,12}, {4,6}};
// Sort by burst time (simple bubble sort)
for (int i = 0; i < 3; i++)
for (int j = 0; j < 3-i; j++)
if (p[j].bt > p[j+1].bt) {
struct Process temp = p[j];
p[j] = p[j+1];
p[j+1] = temp;
}
p[0].wt = 0;
for (int i = 1; i < 4; i++) p[i].wt = p[i-1].wt + p[i-1].bt;
for (int i = 0; i < 4; i++) p[i].tat = p[i].wt + p[i].bt;
printf("Process\tBurst\tWait\tTurnaround\n");
for (int i = 0; i < 4; i++) printf("P%d\t%d\t%d\t%d\n", p[i].id, p[i].bt, p[i].wt, p[i].tat);
return 0;
}






10. Round Robin (Quantum = 4)
#include <stdio.h>
int main() {
int n = 4, quantum = 4;
int bt[] = {5, 8, 12, 6};
int rem_bt[4];
for (int i = 0; i < n; i++) rem_bt[i] = bt[i];
int t = 0, wt[4] = {0}, tat[4];
while (1) {
int done = 1;
for (int i = 0; i < n; i++) {
if (rem_bt[i] > 0) {
done = 0;
if (rem_bt[i] > quantum) {
t += quantum;
rem_bt[i] -= quantum;
} else {
t += rem_bt[i];
wt[i] = t - bt[i];
rem_bt[i] = 0;
}
}
}
if (done) break;
}
for (int i = 0; i < n; i++) tat[i] = bt[i] + wt[i];
printf("Process\tBurst\tWait\tTurnaround\n");
for (int i = 0; i < n; i++) printf("P%d\t%d\t%d\t%d\n", i+1, bt[i], wt[i], tat[i]);
return 0;
}








11 Implementing Dining-Philosophers Problem
→Five philosophers sit at a dining table to eat a bowl of rice. →Among five
chopsticks each philosopher has to pick up his left & right chopsticks to eat.
→A philosopher state will be either thinking or eating.
→ No two neighboring philosophers should eat at the same time
We implement this using semaphores.
We use chopsticks as a semaphore variable.
AIM: C Program to implement Dining-Philosophers Problem
PROGRAM:
#include<stdio.h>
#include<semaphore.h>
#include<pthread.h>
#include<unistd.h>
sem_t chopstick[5];
pthread_t philos[5];
void *f1(void *p)
{
 int k=*(int *)p;
 printf("Phiolospher-%d thinking\n",k);
 sleep(5);
 sem_wait(&chopstick[k]);
 sem_wait(&chopstick[(k+1)%5]);
 printf("Phiolospher-%d eating\n",k);
 sleep(5);
 sem_post(&chopstick[k]);
 sem_post(&chopstick[(k+1)%5]);
 printf("Phiolospher-%d finished eating\n",k);
}
int main()
{

 int i;
 for(i=0;i<5;i++)
 sem_init(&chopstick[i],0,1);
 for(i=0;i<5;i++)
 {
 pthread_create(&philos[i],NULL,f1,&i);
 sleep(1);
 }
 for(i=0;i<5;i++)
 pthread_join(philos[i],NULL);
return 0;
}






12 Implementing Producer-Consumer problem
→ Two Processes namely Producer and Consumer tries to access a shared buffer in a
synchronized manner.
→ A Producer will place a new item only if the buffer is free otherwise it waits.
→ A Consumer will consume the item only if the buffer is not empty otherwise it waits.
→ The buffer can hold from at least 1 to N items.
We use semaphores for implementing this problem.
AIM: C Program to implement Producer-Consumer Problem
PROGRAM:
#include <stdio.h>
#include<unistd.h>
#include<semaphore.h>
#include<pthread.h>
int item,n=5;
sem_t mutex,empty,full;
void *producer()
{
 while(1)
 {
 sem_wait(&empty);
 sem_wait(&mutex);
 item++;
 sleep(2);
 printf("Producer produced item:%d\n",item);
 sem_post(&mutex);
 sem_post(&full);
 }
}
void *consumer()
{
 while(1)
 {
 sem_wait(&full);
 sem_wait(&mutex);
 sleep(2);
 printf("Consumer consumed item:%d\n",item--);
 sem_post(&mutex);
 sem_post(&empty);
 }
}
int main()
{
 pthread_t p,c;
 sem_init(&mutex,0,1);
 sem_init(&full,0,0);
 sem_init(&empty,0,n);
 pthread_create(&p,NULL,producer,NULL);
 pthread_create(&c,NULL,consumer,NULL);
 pthread_join(p,NULL);
 pthread_join(c,NULL);
 return 0;
}






13 Implementing Readers-Writers Problem
→ Two processes namely Reader and Writer tries to access a shared region in a synchronized
manner.
→ The shared region contains some data to be modified by Writer and some data to be accessed
by Reader.
→There could be multiple Readers and Writer processes to access the shared data.
→ Following conflicts should be avoided while Reader and Writer enters a shared region.
i) Reader-Writer
ii) Writer-Reader
iii) Writer-Writer
→ Above process combinations cannot enter a shared region and access shared data at the same
time.
→ Two Readers can enter a shared region and access the shared data at the same time.
We use semaphores for implementing this problem.
AIM: C Program to implement Readers-Writers Problem
PROGRAM:
#include <stdio.h>
#include<unistd.h>
#include<semaphore.h>
#include<pthread.h>
int item,rcount;
sem_t mutex,rwmutex;
void *writer(void *i)
{
 int k=*(int*)i;
 while(1)
 {
 sleep(2);
 sem_wait(&rwmutex);
 item++;
 printf("Writer-%d updated item:%d\n",k,item);
 sleep(2);
 sem_post(&rwmutex);
 }
}
void *reader(void *i)
{
 int k=*(int*)i;
 while(1)
 {
 sleep(5);
 sem_wait(&mutex);
 rcount++;
 if(rcount==1)
 sem_wait(&rwmutex);

 printf("Reader-%d reads item:%d\n",k,item);
 sleep(5);
 sem_post(&mutex);

 sem_wait(&mutex);
 rcount--;
 if(rcount==0)
 sem_post(&rwmutex);
 sem_post(&mutex);
 }
}
int main()
{
 pthread_t r[10],w[5];
 int i;
 sem_init(&mutex,0,1);
 sem_init(&rwmutex,0,100);

 for(i=0;i<5;i++)
 {
 pthread_create(&w[i],NULL,writer,&i);
 }
 for(i=0;i<10;i++){
 pthread_create(&r[i],NULL,reader,&i);
 }
 for(i=0;i<5;i++)
 {
 pthread_join(w[i],NULL);
 }
 for(i=0;i<10;i++){
 pthread_join(r[i],NULL);
 }
 return 0;
}
