13-14. Readers-Writers Problem
C
#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>
sem_t wrt, mutex;
int readcount = 0;
void* reader(void* arg) {
sem_wait(&mutex);
readcount++;
if (readcount == 1) sem_wait(&wrt);
sem_post(&mutex);
printf("Reader reading... (readers: %d)\n", readcount);
sleep(1);
sem_wait(&mutex);
readcount--;
if (readcount == 0) sem_post(&wrt);
sem_post(&mutex);
return NULL;
}
void* writer(void* arg) {
sem_wait(&wrt);
printf("Writer writing...\n");
sleep(1);
sem_post(&wrt);
return NULL;
}
int main() {
pthread_t r[5], w[2];
sem_init(&wrt, 0, 1);
sem_init(&mutex, 0, 1);
// Create some readers and writers
for (int i = 0; i < 5; i++) pthread_create(&r[i], NULL, reader, NULL);
for (int i = 0; i < 2; i++) pthread_create(&w[i], NULL, writer, NULL);
for (int i = 0; i < 5; i++) pthread_join(r[i], NULL);
for (int i = 0; i < 2; i++) pthread_join(w[i], NULL);
return 0;
}
