4. Write a program to illustrate creation of thread using POSIX threads
C
#include <stdio.h>
#include <pthread.h>
void* thread_func(void* arg) {
int id = *(int*)arg;
printf("Thread %d running.\n", id);
return NULL;
}
int main() {
pthread_t threads[3];
int ids[3] = {1, 2, 3};
for (int i = 0; i < 3; i++) {
pthread_create(&threads[i], NULL, thread_func, &ids[i]);
}
for (int i = 0; i < 3; i++) {
pthread_join(threads[i], NULL);
}
printf("All threads finished.\n");
return 0;
}
