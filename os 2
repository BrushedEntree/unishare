8. FCFS Scheduling
C
#include <stdio.h>
int main() {
int n = 4;
int bt[] = {5, 8, 12, 6}; // Burst times
int wt[4], tat[4];
float avg_wt = 0, avg_tat = 0;
wt[0] = 0;
for (int i = 1; i < n; i++) wt[i] = wt[i-1] + bt[i-1];
for (int i = 0; i < n; i++) {
tat[i] = wt[i] + bt[i];
avg_wt += wt[i];
avg_tat += tat[i];
}
printf("Process\tBurst\tWait\tTurnaround\n");
for (int i = 0; i < n; i++) printf("P%d\t%d\t%d\t%d\n", i+1, bt[i], wt[i], tat[i]);
printf("Avg Wait: %.2f\nAvg TAT: %.2f\n", avg_wt/n, avg_tat/n);
return 0;
}
