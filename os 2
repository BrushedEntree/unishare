10. Round Robin (Quantum = 4)
C
#include <stdio.h>
int main() {
int n = 4, quantum = 4;
int bt[] = {5, 8, 12, 6};
int rem_bt[4];
for (int i = 0; i < n; i++) rem_bt[i] = bt[i];
int t = 0, wt[4] = {0}, tat[4];
while (1) {
int done = 1;
for (int i = 0; i < n; i++) {
if (rem_bt[i] > 0) {
done = 0;
if (rem_bt[i] > quantum) {
t += quantum;
rem_bt[i] -= quantum;
} else {
t += rem_bt[i];
wt[i] = t - bt[i];
rem_bt[i] = 0;
}
}
}
if (done) break;
}
for (int i = 0; i < n; i++) tat[i] = bt[i] + wt[i];
printf("Process\tBurst\tWait\tTurnaround\n");
for (int i = 0; i < n; i++) printf("P%d\t%d\t%d\t%d\n", i+1, bt[i], wt[i], tat[i]);
return 0;
}
