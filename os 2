1. Write a program to make a parent process wait for child process
C
#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>
#include <stdlib.h>
int main() {
pid_t pid = fork();
if (pid == 0) {
// Child process
printf("Child process (PID: %d) executing...\n", getpid());
sleep(2); // Simulate work
printf("Child process exiting.\n");
exit(0);
} else if (pid > 0) {
// Parent process
printf("Parent process (PID: %d) waiting for child (PID: %d)...\n", getpid(), pid);
wait(NULL); // Wait for child to finish
printf("Parent process: Child has finished. Exiting.\n");
} else {
perror("fork failed");
exit(1);
}
return 0;
}
Sample Output:
text
Parent process (PID: 1234) waiting for child (PID: 1235)...
Child process (PID: 1235) executing...
Child process exiting.
Parent process: Child has finished. Exiting.
2. Write a program to create a zombie process
C
#include <stdio.h>
#include <unistd.h>
#include <stdlib.h>
int main() {
pid_t pid = fork();
if (pid == 0) {
// Child process
printf("Child (PID: %d) exiting immediately.\n", getpid());
exit(0);
} else if (pid > 0) {
// Parent process
printf("Parent (PID: %d) sleeping. Child becomes zombie.\n", getpid());
sleep(30); // Keep parent alive to observe zombie (use 'ps' in another terminal)
printf("Parent exiting. Zombie reaped.\n");
} else {
perror("fork failed");
}
return 0;
}
Sample Output:
text
