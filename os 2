7. Write a program to illustrate how a single function can handle more than one process
(signals)
C
#include <stdio.h>
#include <signal.h>
#include <unistd.h>
void signal_handler(int sig) {
if (sig == SIGINT) printf("Caught SIGINT (Ctrl+C)\n");
else if (sig == SIGTERM) printf("Caught SIGTERM\n");
}
int main() {
struct sigaction sa;
sa.sa_handler = signal_handler;
sigemptyset(&sa.sa_mask);
sa.sa_flags = 0;
sigaction(SIGINT, &sa, NULL);
sigaction(SIGTERM, &sa, NULL);
printf("Waiting for signals... (Ctrl+C or kill -15 %d)\n", getpid());
while(1) pause();
return 0;
}
